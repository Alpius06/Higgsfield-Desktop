{
  "name": "higgsfield-desktop",
  "productName": "Higgsfield",
  "version": "2.4.1",
  "description": "Desktop app for higgsfield.ai on Windows and macOS: dockable tabs, workspaces, Cinema Studio project folders and generation alerts",
  "author": "Radu@BadWolf <contact@badwolf.ro>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/badwolf-ro/Higgsfield-Desktop.git"
  },
  "homepage": "https://github.com/badwolf-ro/Higgsfield-Desktop",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "ro.badwolf.higgsfield",
    "productName": "Higgsfield",
    "files": [
      "main.js",
      "src/**/*",
      "build/icon.png",
      "build/icon-mac.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Higgsfield"
    },
    "portable": {
      "artifactName": "Higgsfield-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.graphics-design",
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Higgsfield pages can use your camera when you choose to record or upload from it.",
        "NSMicrophoneUsageDescription": "Higgsfield pages can use your microphone when you choose to record audio."
      },
      "artifactName": "Higgsfield-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "Higgsfield-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "dockview-core": "^8.3.1"
  }
}
